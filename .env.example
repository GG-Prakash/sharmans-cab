# Copy to .env.local for local development. Never commit real values.

# --- Public site ---
NEXT_PUBLIC_SITE_URL=https://sharmanscab.com
# Only "true" on the real production domain. Anything else = noindex (previews, POC).
NEXT_PUBLIC_INDEXABLE=false
NEXT_PUBLIC_GTM_ID=
# "false" removes the "Preview concept" banner and the desk's sample-data bar (do this at go-live).
NEXT_PUBLIC_PREVIEW=true

# --- Database ---
# Leave empty locally: an embedded Postgres (PGlite) is stored in ./.data/pglite.
# REQUIRED in production, e.g. Neon (region: Mumbai / ap-south-1), Supabase, AWS RDS.
DATABASE_URL=

# --- Booking desk (/admin) ---
# Shared desk password (8+ chars). Staff type their own name at sign-in.
ADMIN_PASSWORD=
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- New-lead notifications (all optional) ---
# Any webhook: Zoho Flow → Zoho CRM, Zapier, Make, Google Sheets…
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
# Email alerts via Resend (resend.com)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=MailBox@agniSharman.com
LEAD_FROM_EMAIL=
